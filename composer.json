{
	"name": "tunet/volumina",
	"description": "Audiobook player and library for WordPress.",
	"type": "wordpress-plugin",
	"keywords": ["wordpress", "plugin", "audiobook", "audio", "player"],
	"homepage": "https://tunetdesign.com",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "TUNET",
			"email": "ai@tunetdesign.com",
			"homepage": "https://tunetdesign.com"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"TUNET\\Volumina\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"TUNET\\Volumina\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"sort-packages": true
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"scripts": {
		"lint": [
			"@phpcs",
			"@phpstan"
		],
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=1G"
	},
	"scripts-descriptions": {
		"lint": "Run PHPCS and PHPStan, the definition of done for PHP.",
		"phpcs": "Check the code against the WordPress coding standards.",
		"phpcbf": "Fix automatically fixable coding standard violations.",
		"phpstan": "Static analysis at level 6."
	}
}
