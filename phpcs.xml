<?xml version="1.0"?>
<ruleset name="Volumina">
	<description>WordPress coding standards for Volumina.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<!-- Generated by `wp i18n make-php`; the loader wants them exactly as written. -->
	<exclude-pattern>/languages/*.l10n.php</exclude-pattern>
	<!-- QA scripts run through wp eval-file against a test site; never shipped. -->
	<exclude-pattern>/tests/qa/*</exclude-pattern>
	<exclude-pattern>/.playwright-mcp/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- File names follow PSR-4, enforced by Composer autoloading. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="volumina"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="volumina"/>
				<element value="TUNET\Volumina"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
