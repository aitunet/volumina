{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "volumina/continue-listening",
	"title": "Continue listening",
	"category": "media",
	"icon": "controls-play",
	"description": "The audiobooks this listener has started, and where they left off.",
	"keywords": [ "audiobook", "resume", "continue", "listening" ],
	"textdomain": "volumina",
	"attributes": {
		"count": {
			"type": "number",
			"default": 3
		},
		"showCovers": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "volumina-book",
	"viewScript": "volumina-continue"
}
