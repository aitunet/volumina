{
	"name": "volumina",
	"version": "1.0.0",
	"description": "Audiobook player and library for WordPress.",
	"author": "TUNET <ai@tunetdesign.com> (https://tunetdesign.com)",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"plugin",
		"audiobook",
		"audio",
		"player"
	],
	"homepage": "https://tunetdesign.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aitunet/volumina.git"
	},
	"bugs": {
		"url": "https://github.com/aitunet/volumina/issues"
	},
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@wordpress/block-editor": "^17.0.0",
		"@wordpress/blocks": "^15.27.0",
		"@wordpress/components": "^40.0.0",
		"@wordpress/core-data": "^7.54.0",
		"@wordpress/data": "^10.54.0",
		"@wordpress/editor": "^14.54.0",
		"@wordpress/env": "^11.14.0",
		"@wordpress/html-entities": "^4.54.0",
		"@wordpress/i18n": "^6.27.0",
		"@wordpress/scripts": "^34.2.0",
		"@wordpress/server-side-render": "^6.30.0"
	},
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=blocks --output-path=build",
		"start": "wp-scripts start --webpack-src-dir=blocks --output-path=build",
		"format": "wp-scripts format",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:pkg-json",
		"lint:js": "wp-scripts lint-js ./assets ./blocks",
		"lint:css": "wp-scripts lint-style",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"test:e2e": "wp-scripts test-playwright",
		"packages-update": "wp-scripts packages-update",
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"make-pot": "wp-env run --env-cwd=wp-content/plugins/volumina cli wp i18n make-pot . languages/volumina.pot --domain=volumina --exclude=node_modules,vendor,build,tests"
	}
}
